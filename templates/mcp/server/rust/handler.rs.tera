/// Auto-generated unified parameters struct for `/{{ endpoint }}` endpoint.
/// Combines query parameters and request body properties into a single MCP interface.
/// Spec:{% if spec_file_name %} {{ spec_file_name }}{% endif %}
#[derive(Clone, Debug, Default, Deserialize, Serialize, JsonSchema, ToSchema)]
pub struct {{ parameters_type }} {
    {% if unified_parameters | length > 0 -%}
    {% for p in unified_parameters -%}
    {% if p.source == "Query" -%}
    {% if p.description -%}
    #[schemars(description = r#"{{ p.description }} (query param)"#)]
    {% else -%}
    #[schemars(description = r#"Query parameter"#)]
    {% endif -%}
    pub {{ p.name | rust_escape_keyword }}: Option<{{ p.rust_type }}>,
    {% endif -%}
    {% endfor -%}
    {% endif -%}
    {% if http_method == "POST" -%}
    /// The request body data (no validation - context broker will handle it)
    pub data: Option<serde_json::Value>,
    {% endif -%}
}

// Implement Endpoint for generic handler
impl Endpoint for {{ parameters_type }} {
    fn path() -> &'static str {
        "{{ path }}"
    }

    fn get_params(&self) -> HashMap<String, String> {
        {% set has_query_params = false -%}
        {% for p in unified_parameters -%}
        {% if p.source == "Query" -%}
        {% set_global has_query_params = true -%}
        {% endif -%}
        {% endfor -%}
        {% if has_query_params -%}
        let mut params = HashMap::new();
        {% for p in unified_parameters -%}
        {% if p.source == "Query" -%}
        if let Some(val) = &self.{{ p.name | rust_escape_keyword }} {
            {% if p.rust_type is containing("Vec") -%}
            // Handle array parameters by joining values with commas
            // This creates query strings like: ?tags=tag1,tag2,tag3
            // Server must split by comma to reconstruct the array
            params.insert("{{ p.original_name }}".to_string(), val.join(","));
            {%- else -%}
            params.insert("{{ p.original_name }}".to_string(), val.to_string());
            {%- endif %}
        }
        {% endif -%}
        {% endfor -%}
        params
        {%- else -%}
        HashMap::new()
        {%- endif %}
    }
}

impl {{ parameters_type }} {
    {% set has_query_params = false -%}
    {% for p in unified_parameters -%}
    {% if p.source == "Query" -%}
    {% set_global has_query_params = true -%}
    {% endif -%}
    {% endfor -%}
    {% if has_query_params -%}
    /// Extract query parameters for REST API calls
    pub fn to_query_params(&self) -> HashMap<String, String> {
        self.get_params()
    }
    {% endif -%}

{% if has_body_properties -%}
    /// Extract request body properties for REST API calls
    /// Returns a serde_json::Value::Object with original OpenAPI property names as keys.
    pub fn to_request_body_json(&self) -> Result<serde_json::Value, serde_json::Error> {
        let mut body_map = serde_json::Map::new();
        {% for p in unified_parameters -%}
        {% if p.source == "Body" -%}
        if let Some(val) = &self.{{ p.name | rust_escape_keyword }} {
            body_map.insert("{{ p.original_name }}".to_string(), serde_json::to_value(val)?);
        }
        {% endif -%}
        {% endfor -%}
        Ok(serde_json::Value::Object(body_map))
    }
{% endif -%}
}

// Removed {{ endpoint_cap }}RequestBody struct as it's no longer needed.
// The request body is now constructed directly as a JSON object using original names.

{%- if response_is_array %}
#[derive(Clone, Debug, Serialize, Deserialize, JsonSchema, ToSchema)]
pub struct {{ endpoint_cap }}Response(pub Vec<{{ response_item_type }}>);
{%- elif response_is_object %}
#[derive(Clone, Debug, Serialize, Deserialize, JsonSchema, ToSchema)]
pub struct {{ response_type }} {
{%- for prop in response_properties %}
    #[schemars(description = r#"{{ prop.title }} - {{ prop.description }}"#)]
    pub {{ prop.name | rust_escape_keyword }}: Option<{{ prop.rust_type }}>,
{%- endfor %}
}
{%- elif response_is_primitive %}
#[derive(Clone, Debug, Serialize, Deserialize, JsonSchema, ToSchema)]
pub struct {{ endpoint_cap }}Response(pub {{ response_primitive_type }});
{%- else %}
#[derive(Clone, Debug, Serialize, Deserialize, JsonSchema, ToSchema)]
pub struct {{ endpoint_cap }}Response(pub serde_json::Value);
{%- endif %}

impl IntoContents for {{ response_type }} {
    fn into_contents(self) -> Vec<Content> {
        // Convert the response into a Vec<Content> as expected by MCP
        // Panics only if serialization fails, which should be impossible for valid structs
        vec![Content::json(self).expect("Failed to serialize {{ endpoint_cap }}Response to Content")]
    }
}

/// `{{ path }}` endpoint handler
/// {{ summary }}
{%- if description %}
/// {{ description }}
{%- endif %}
{%- if parameters %}
#[doc = r#"{% for p in parameters %}{%- if p.name %} - `{{ p.name }}` ({{ p.rust_type }}, optional): {% if p.description %}{{ p.description | trim }}{% else %}No description{% endif %}{% if p.example %}
{{ p.example }}{% endif %}{% endif %}{% endfor %}"#]
{%- endif %}
#[doc = r#"Verb: GET
Path: {{ path }}
Parameters: {{ parameters_type }}
Responses:
    200: Successful Operation
    400: Bad input parameter
    500: Internal Server Error
    502: Bad Gateway
    503: Service Unavailable
    504: Gateway Timeout
Tag: {% if tags and tags | length > 0 %}{{ tags.0 }}{% else %}untagged{% endif %}"#]
pub async fn {{ endpoint }}_handler(
    config: &Config,
    params: &{{ parameters_type }},
) -> Result<CallToolResult, agenterra_rmcp::Error> {
    // Log incoming MCP request details for debugging
    tracing::info!(
        target = "mcp_request",
        event = "incoming_mcp_request",
        endpoint = "{{ endpoint }}",
        method = "{{ http_method }}",
        path = "{{ path }}",
        params = ?params
    );

    // Log incoming request parameters and request details as structured JSON
    info!(
        target = "handler",
        event = "incoming_request",
        endpoint = "{{ endpoint }}",
        method = "{{ http_method }}",
        path = "{{ path }}",
        params = serde_json::to_string(params).unwrap_or_else(|e| {
            warn!("Failed to serialize request params: {e}");
            "{}".to_string()
        })
    );
    debug!(
        target = "handler",
        event = "before_api_call",
        endpoint = "{{ endpoint }}"
    );
    {% if http_method == "POST" -%}
    let request_body = params.data.clone();
    {%- elif has_body_properties -%}
    let request_body = Some(params.to_request_body_json().map_err(|e| {
        error!("Failed to serialize request body: {}", e);
        agenterra_rmcp::Error::internal(format!("Serialization failed: {}", e))
    })?);
    {%- else -%}
    let request_body = None;
    {%- endif %}
    let resp =
        get_endpoint_response::<_, {{ response_type }}>(config, params, "{{ http_method }}", request_body).await;

    match &resp {
        Ok(r) => {
            info!(
                target = "handler",
                event = "api_response",
                endpoint = "{{ endpoint }}",
                response = ?r
            );
        }
        Err(e) => {
            error!(target = "handler", event = "api_error", endpoint = "{{ endpoint }}", error = ?e);
        }
    }

    // Log outgoing API request as structured JSON
    resp.and_then(|r| r.into_call_tool_result())
}

#[cfg(test)]
mod tests {
    use super::*;
    use serde_json;
    #[test]
    fn test_parameters_struct_serialization() {
        let params = {{ parameters_type }} {
            {% if unified_parameters | length > 0 -%}
            {% for p in unified_parameters -%}
            {{ p.name | rust_escape_keyword }}: None,
            {% endfor -%}
            {% endif -%}
            {% if http_method == "POST" -%}
            data: None,
            {% endif -%}
        };
        let _ = serde_json::to_string(&params).expect("Serializing test params should not fail");
    }

    {% if has_body_properties -%}
    #[test]
    fn test_to_request_body_json() {
        // Assuming 'type' is a body property and a Rust keyword
        let params = {{ parameters_type }} {
            {% for p in unified_parameters -%}
            {% if p.source == "Body" -%}
            {% if p.original_name == "type" -%}
            r#type: Some("some_type_value".to_string()),
            {% else -%}
            {{ p.name | rust_escape_keyword }}: Some("some_value".to_string()),
            {% endif -%}
            {% else -%}
            {{ p.name | rust_escape_keyword }}: None,
            {% endif -%}
            {% endfor -%}
        };

        let body_json = params.to_request_body_json();
        // Check that the original name 'type' is used as the JSON key, not 'r#type'
        {% for p in unified_parameters -%}
        {% if p.source == "Body" -%}
        {% if p.original_name == "type" -%}
        assert_eq!(body_json["type"], "some_type_value");
        {% else -%}
        assert_eq!(body_json["{{ p.original_name }}"], "some_value");
        {% endif -%}
        {% endif -%}
        {% endfor -%}
    }
    {% endif -%}
}
